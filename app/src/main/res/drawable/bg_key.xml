<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="@color/key_bg_active"/><corners android:radius="6dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/accent"/><corners android:radius="6dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/key_bg"/><corners android:radius="6dp"/></shape>
    </item>
</selector>
